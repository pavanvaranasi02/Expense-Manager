{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KOSH Firestore Database Schema",
  "version": "1.3.4",
  "description": "Machine-readable schema definition for KOSH Cloud Firestore database",
  "collections": {
    "users": {
      "path": "users/{userId}",
      "description": "User profile and global user settings",
      "fields": {
        "name": { "type": "string", "required": true },
        "email": { "type": "string", "required": true },
        "phone": { "type": ["string", "null"], "required": false },
        "role": { "type": "string", "enum": ["USER", "ADMIN"], "default": "USER" },
        "currency": { "type": "string", "default": "INR" },
        "currencySymbol": { "type": "string", "default": "₹" },
        "authProvider": { "type": "string", "enum": ["email", "google"] },
        "profileImage": { "type": ["string", "null"] },
        "onboardingComplete": { "type": "boolean", "default": false },
        "showInvestmentsInAssets": { "type": "boolean", "default": false },
        "showTabLabels": { "type": "boolean", "default": true },
        "isStealthMode": { "type": "boolean", "default": false },
        "familyId": { "type": ["string", "null"] },
        "notificationSettings": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "sipReminders": { "type": "boolean", "default": true },
            "rdReminders": { "type": "boolean", "default": true },
            "maturityAlerts": { "type": "boolean", "default": true },
            "budgetAlerts": { "type": "boolean", "default": true },
            "creditCardAlerts": { "type": "boolean", "default": true },
            "emiAlerts": { "type": "boolean", "default": true },
            "dailyReminder": { "type": "boolean", "default": true }
          }
        },
        "isActive": { "type": "boolean", "default": true },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" },
        "lastLoginAt": { "type": "timestamp" }
      },
      "subcollections": {
        "accounts": {
          "path": "users/{userId}/accounts/{accountId}",
          "fields": {
            "name": { "type": "string", "required": true },
            "type": { "type": "string", "enum": ["BANK", "CASH", "CREDIT_CARD", "OTHER"], "required": true },
            "bankName": { "type": ["string", "null"] },
            "accountNumber": { "type": ["string", "null"] },
            "balance": { "type": "number", "default": 0 },
            "hasDebitCard": { "type": "boolean", "default": false },
            "debitCardLast4": { "type": ["string", "null"] },
            "creditLimit": { "type": "number", "default": 0 },
            "currentUsage": { "type": "number", "default": 0 },
            "availableCredit": { "type": "number", "default": 0 },
            "billGenerationDate": { "type": "integer", "default": 1 },
            "billDueDate": { "type": "integer", "default": 15 },
            "interestRate": { "type": "number", "default": 36 },
            "userSpendLimit": { "type": ["number", "null"] },
            "alertAt": { "type": "integer", "default": 80 },
            "lastBillPaidAmount": { "type": "number", "default": 0 },
            "lastBillPaidDate": { "type": ["string", "null"] },
            "unpaidBillAmount": { "type": "number", "default": 0 },
            "billPaymentHistory": { "type": "array" },
            "color": { "type": "string", "default": "#455A64" },
            "icon": { "type": "string", "default": "card" },
            "isDefault": { "type": "boolean", "default": false },
            "createdAt": { "type": "timestamp" },
            "updatedAt": { "type": "timestamp" }
          }
        },
        "expenses": {
          "path": "users/{userId}/expenses/{expenseId}",
          "fields": {
            "amount": { "type": "number", "required": true },
            "categoryId": { "type": "string", "required": true },
            "categoryName": { "type": "string", "required": true },
            "categoryIcon": { "type": "string", "default": "📦" },
            "accountId": { "type": ["string", "null"] },
            "accountName": { "type": "string", "default": "Unknown" },
            "paymentMode": { "type": "string", "required": true },
            "isCredit": { "type": "boolean", "default": false },
            "date": { "type": "timestamp", "required": true },
            "note": { "type": "string", "default": "" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "_pendingSync": { "type": "boolean", "default": false },
            "createdAt": { "type": "timestamp" },
            "updatedAt": { "type": "timestamp" }
          }
        },
        "incomes": {
          "path": "users/{userId}/incomes/{incomeId}",
          "fields": {
            "amount": { "type": "number", "required": true },
            "source": { "type": "string", "required": true },
            "sourceName": { "type": "string" },
            "sourceIcon": { "type": "string", "default": "💼" },
            "accountId": { "type": "string", "required": true },
            "accountName": { "type": "string" },
            "date": { "type": "timestamp", "required": true },
            "note": { "type": "string", "default": "" },
            "createdAt": { "type": "timestamp" },
            "updatedAt": { "type": "timestamp" }
          }
        },
        "budgets": {
          "path": "users/{userId}/budgets/{budgetId}",
          "fields": {
            "type": { "type": "string", "enum": ["OVERALL", "CATEGORY"], "default": "CATEGORY" },
            "categoryId": { "type": "string", "required": true },
            "categoryName": { "type": "string" },
            "amount": { "type": "number", "required": true },
            "month": { "type": "integer", "minimum": 0, "maximum": 11, "required": true },
            "year": { "type": "integer", "required": true },
            "alertAt": { "type": "integer", "default": 80 },
            "createdAt": { "type": "timestamp" },
            "updatedAt": { "type": "timestamp" }
          }
        },
        "investments": {
          "path": "users/{userId}/investments/{investmentId}",
          "fields": {
            "name": { "type": "string", "required": true },
            "type": {
              "type": "string",
              "enum": [
                "mutual_fund", "stocks", "foreign_stocks", "fd", "rd", "ppf",
                "gold", "crypto", "real_estate", "nps", "bonds", "other"
              ],
              "required": true
            },
            "typeName": { "type": "string" },
            "typeIcon": { "type": "string", "default": "💰" },
            "platform": { "type": ["string", "null"] },
            "currency": { "type": "string", "default": "INR" },
            "exchangeRate": { "type": "number", "default": 1 },
            "investedAmount": { "type": "number", "default": 0 },
            "currentValue": { "type": "number", "default": 0 },
            "interestRate": { "type": ["number", "null"] },
            "startDate": { "type": "string" },
            "note": { "type": "string", "default": "" },
            "isActive": { "type": "boolean", "default": true },
            "sipAmount": { "type": ["number", "null"] },
            "sipDate": { "type": ["integer", "null"] },
            "sipHistory": { "type": "array" },
            "rdMonthlyAmount": { "type": ["number", "null"] },
            "rdTotalMonths": { "type": ["integer", "null"] },
            "rdCompletedMonths": { "type": "integer", "default": 0 },
            "rdPaymentDate": { "type": ["integer", "null"] },
            "rdPaymentHistory": { "type": "array" },
            "maturityAmount": { "type": ["number", "null"] },
            "maturityDate": { "type": ["string", "null"] },
            "paidFromAccountId": { "type": ["string", "null"] },
            "autoMaturityCredit": { "type": "boolean", "default": false },
            "maturityCredited": { "type": "boolean", "default": false },
            "transactions": { "type": "array" },
            "createdAt": { "type": "timestamp" },
            "updatedAt": { "type": "timestamp" }
          }
        },
        "emis": {
          "path": "users/{userId}/emis/{emiId}",
          "fields": {
            "name": { "type": "string", "required": true },
            "monthlyAmount": { "type": "number", "required": true },
            "totalMonths": { "type": "integer", "required": true },
            "completedMonths": { "type": "integer", "default": 0 },
            "totalAmount": { "type": "number", "required": true },
            "interestRate": { "type": "number", "default": 0 },
            "processingFee": { "type": "number", "default": 0 },
            "linkedAccountId": { "type": ["string", "null"] },
            "linkedAccountName": { "type": "string" },
            "linkedAccountType": { "type": "string", "default": "CREDIT_CARD" },
            "debitDay": { "type": "integer", "default": 5 },
            "startDate": { "type": "string" },
            "endDate": { "type": ["string", "null"] },
            "maturedDate": { "type": ["string", "null"] },
            "status": { "type": "string", "enum": ["ACTIVE", "COMPLETED", "CANCELLED"], "default": "ACTIVE" },
            "isActive": { "type": "boolean", "default": true },
            "note": { "type": "string", "default": "" },
            "paymentHistory": { "type": "array" },
            "createdAt": { "type": "timestamp" },
            "updatedAt": { "type": "timestamp" }
          }
        },
        "custom_categories": {
          "path": "users/{userId}/custom_categories/{categoryId}",
          "fields": {
            "name": { "type": "string", "required": true },
            "icon": { "type": "string", "default": "📦" },
            "color": { "type": "string", "default": "#6C63FF" },
            "isDefault": { "type": "boolean", "default": false },
            "createdAt": { "type": "timestamp" }
          }
        },
        "notifications": {
          "path": "users/{userId}/notifications/{notificationId}",
          "fields": {
            "title": { "type": "string", "required": true },
            "message": { "type": "string", "required": true },
            "type": { "type": "string", "required": true },
            "read": { "type": "boolean", "default": false },
            "metadata": { "type": "object" },
            "createdAt": { "type": "timestamp" }
          }
        }
      }
    },
    "families": {
      "path": "families/{familyId}",
      "description": "Family financial groups and shared records",
      "fields": {
        "name": { "type": "string", "required": true },
        "inviteCode": { "type": "string", "required": true },
        "ownerId": { "type": "string", "required": true },
        "coAdminId": { "type": ["string", "null"] },
        "memberCount": { "type": "integer", "default": 1 },
        "members": { "type": "array" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "subcollections": {
        "expenses": {
          "path": "families/{familyId}/expenses/{expenseId}"
        },
        "budgets": {
          "path": "families/{familyId}/budgets/{budgetId}"
        },
        "templates": {
          "path": "families/{familyId}/templates/{templateId}"
        }
      }
    }
  }
}
